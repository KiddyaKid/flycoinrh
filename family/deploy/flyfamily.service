[Unit]
Description=FLYFAMILY shared browser and MaleCNS observer
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=flyfamily
Group=flyfamily
WorkingDirectory=/opt/flyfamily/family
EnvironmentFile=/etc/flyfamily/runtime.env
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/flyfamily/browsers
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/usr/bin/node /opt/flyfamily/family/deploy/check-start.mjs
# Preparation only: this unit does not enable automatic signing.
ExecStart=/usr/bin/node /opt/flyfamily/family/server.mjs
Restart=on-failure
RestartSec=15
KillMode=control-group
TimeoutStopSec=150
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/flyfamily
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
